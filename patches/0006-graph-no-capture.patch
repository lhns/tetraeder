From: Tetraeder
Subject: [PATCH] ggml: ggml_graph_set_no_capture, a per-graph opt-out of CUDA graph capture

ggml-cuda captures a graph on its second call with unchanged node properties. A graph whose
shapes change on every call (prefill) never replays, and its capture call blocks the issuing
thread. A flagged graph runs directly on every call and its warm-up state, uid and node
properties are left alone. Default false, views start unflagged, other backends ignore it. ADR 0081.
---
diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 87bca98..03dcf5f 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -2684,6 +2684,9 @@ extern "C" {
     GGML_API void                 ggml_graph_cpy       (struct ggml_cgraph * src, struct ggml_cgraph * dst);
     GGML_API void                 ggml_graph_reset     (struct ggml_cgraph * cgraph); // set regular grads + optimizer momenta to 0, set loss grad to 1
     GGML_API void                 ggml_graph_clear     (struct ggml_cgraph * cgraph);
+    // true: ggml-cuda runs this graph directly on every call, never capturing or replaying a CUDA graph
+    // and leaving its warm-up state alone (for graphs whose shapes change on each call); other backends ignore it
+    GGML_API void ggml_graph_set_no_capture(struct ggml_cgraph * cgraph, bool no_capture);
 
     GGML_API int                   ggml_graph_size   (struct ggml_cgraph * cgraph);
     GGML_API struct ggml_tensor *  ggml_graph_node   (struct ggml_cgraph * cgraph, int i); // if i < 0, returns nodes[n_nodes + i]
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index a367d7e..b812dc4 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5441,7 +5441,7 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
     ggml_cuda_graph_set_enabled(cuda_ctx, graph_key);
 
     ggml_cuda_graph * graph = cuda_ctx->cuda_graph(graph_key);
-    if (graph->is_enabled()) {
+    if (!cgraph->no_capture && graph->is_enabled()) {
         // graph->uid is set only for a compatible graph (see ggml_cuda_graph_update_required), so a reused graph needs no new check
         const bool graph_reused     = cgraph->uid != 0 && cgraph->uid == graph->uid;
         const bool graph_compatible = graph_reused || ggml_cuda_graph_check_compability(cgraph);
diff --git a/ggml/src/ggml-impl.h b/ggml/src/ggml-impl.h
index 7c6a605..f377a7d 100644
--- a/ggml/src/ggml-impl.h
+++ b/ggml/src/ggml-impl.h
@@ -363,6 +363,9 @@ struct ggml_cgraph {
     // an optional identifier that can be utilized to recognize same graphs if two non-zero values match
     // a value of 0 means it is not set and should be ignored
     uint64_t uid;
+
+    // run directly, never as a CUDA graph (ggml_graph_set_no_capture); views start with false
+    bool no_capture;
 };
 
 // returns a slice of cgraph with nodes [i0, i1)
diff --git a/ggml/src/ggml.c b/ggml/src/ggml.c
index 209e2c2..ab8fade 100644
--- a/ggml/src/ggml.c
+++ b/ggml/src/ggml.c
@@ -7454,6 +7454,7 @@ struct ggml_cgraph * ggml_new_graph_custom(struct ggml_context * ctx, size_t siz
         /*.hash_table   =*/ { hash_size, hash_used, hash_keys_ptr },
         /*.order        =*/ GGML_CGRAPH_EVAL_ORDER_LEFT_TO_RIGHT,
         /*.uid          =*/ 0,
+        /*.no_capture   =*/ false,
     };
 
     ggml_hash_set_reset(&cgraph->visited_hash_set);
@@ -7481,12 +7482,17 @@ struct ggml_cgraph ggml_graph_view(struct ggml_cgraph * cgraph0, int i0, int i1)
         /*.use_counts       =*/ cgraph0->use_counts,
         /*.visited_hash_set =*/ cgraph0->visited_hash_set,
         /*.order            =*/ cgraph0->order,
-        /*.uid              =*/ 0
+        /*.uid              =*/ 0,
+        /*.no_capture       =*/ false,
     };
 
     return cgraph;
 }
 
+void ggml_graph_set_no_capture(struct ggml_cgraph * cgraph, bool no_capture) {
+    cgraph->no_capture = no_capture;
+}
+
 void ggml_graph_cpy(struct ggml_cgraph * src, struct ggml_cgraph * dst) {
     GGML_ASSERT(dst->size >= src->n_leafs);
     GGML_ASSERT(dst->size >= src->n_nodes);
