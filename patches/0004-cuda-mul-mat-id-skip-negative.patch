+        ggml_cuda_mm_ids_fill(ids_src1.get(), ne_get_rows, 0, stream);
         GGML_ASSERT(ids->nb[0] == ggml_element_size(ids));
         const int si1  = ids->nb[1] / ggml_element_size(ids);
         const int sis1 = nb12 / nb11;
@@ -390,6 +394,10 @@ void ggml_cuda_mul_mat_q(
         ntj, J_best, fusion_device};
 
     ggml_cuda_mul_mat_q_switch_type(ctx, args, stream, prec_src1);
+
+    // patch 0004: expert id -1 matches no expert above; zero its dst rows
+    ggml_cuda_mm_ids_zero_unused((const int32_t *) ids->data, dst_d, ne0, n_expert_used, ne12,
+        ids->nb[0]/ggml_type_size(ids->type), ids->nb[1]/ggml_type_size(ids->type), nb1/ts_dst, nb2/ts_dst, stream);
 }
 
 bool ggml_cuda_should_use_mmq(enum ggml_type type, int cc, int64_t ne11, int64_t n_experts) {
