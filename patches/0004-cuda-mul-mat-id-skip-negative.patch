From: Tetraeder
Subject: [PATCH] cuda: mul_mat_id treats expert id -1 as no expert

As the CPU kernel does: no weights read, zero output row. MMVQ and MMVF write the zero row in the
kernel; MMQ and MMF never match -1 to an expert and a small kernel zeroes its rows; the generic
fallback gathers from a zero row. Results for ids without -1 are unchanged. ADR 0070.
mm_ids_helper counts -1 below every expert, which leaves the first compact rows and the -1 slots'
inverse-map entries unwritten; MMQ's quantize kernels read src1 or scatter through them, so they now
point at row 0. Since b12426 the MMQ and MMF paths read a tile_spec table (stream-k): it is zeroed
before the ids helper so seams past the last compacted column are empty tiles.
---
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 4950b9e..a367d7e 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2606,14 +2606,15 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
 
     std::vector<int32_t> ids_to_sorted_host;
     ids_to_sorted_host.reserve(2*ne_get_rows);
-    std::vector<int32_t> ids_from_sorted_host(ne_get_rows);
+    std::vector<int32_t> ids_from_sorted_host(ne_get_rows, -1);
 
     ggml_cuda_pool_alloc<int32_t> ids_buf_dev(ctx.pool(), 2*ne_get_rows);
 
     std::vector<int32_t> tokens_per_expert(ne02);
 
     ggml_cuda_pool_alloc<char> src1_sorted(ctx.pool(), ne12*n_expert_used*ne10*ts_src1_sorted);
-    ggml_cuda_pool_alloc<char>  dst_sorted(ctx.pool(), ne2 *n_expert_used* ne0*ts_dst_sorted);
+    // one extra row at the end stays zero: the target of every id -1 slot (patch 0004)
+    ggml_cuda_pool_alloc<char>  dst_sorted(ctx.pool(), (ne2*n_expert_used + 1)* ne0*ts_dst_sorted);
 
     std::vector<char> ids_host(ggml_nbytes(ids));
     CUDA_CHECK(cudaMemcpyAsync(ids_host.data(), ids->data, ggml_nbytes(ids), cudaMemcpyDeviceToHost, stream));
@@ -2623,7 +2624,7 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
         for (int64_t i12 = 0; i12 < ne12; ++i12) { // tokens
             for (int64_t iex = 0; iex < n_expert_used; ++iex) {
                 const int32_t expert_to_use = *(const int32_t *)(ids_host.data() + i12*ids->nb[1] + iex*ids->nb[0]);
-                assert(expert_to_use >= 0 && expert_to_use < ne02);
+                assert(expert_to_use < ne02);
                 if (expert_to_use == i02) {
                     ids_from_sorted_host[i12*n_expert_used + iex] = ids_to_sorted_host.size();
                     ids_to_sorted_host.push_back(i12*ne11 + iex % ne11);
@@ -2633,7 +2634,16 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
             }
         }
     }
-    GGML_ASSERT(ids_to_sorted_host.size() == size_t(ne_get_rows));
+    // patch 0004: slots with id -1 compute nothing and read the zero row
+    const int64_t n_valid = ids_to_sorted_host.size();
+    GGML_ASSERT(n_valid <= ne_get_rows);
+    for (int32_t & i : ids_from_sorted_host) {
+        if (i < 0) {
+            i = n_valid;
+        }
+    }
+    CUDA_CHECK(cudaMemsetAsync((char *) dst_sorted.ptr + n_valid*ne0*ts_dst_sorted, 0, ne0*ts_dst_sorted, stream));
+    ids_to_sorted_host.resize(ne_get_rows, 0);
 
     ids_to_sorted_host.insert(ids_to_sorted_host.end(), ids_from_sorted_host.begin(), ids_from_sorted_host.end());
 
@@ -2643,11 +2653,13 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
     const int32_t * ids_to_sorted   = ids_buf_dev.ptr + 0*ne_get_rows;
     const int32_t * ids_from_sorted = ids_buf_dev.ptr + 1*ne_get_rows;
 
-    get_rows_cuda(src1->data, src1->type, ids_to_sorted, src1_sorted.ptr, type_src1_sorted,
-        ne10, nb11, nb12, nb13,
-        ne_get_rows, 1, 1, sizeof(int32_t), ne_get_rows*sizeof(int32_t), ne_get_rows*sizeof(int32_t),
-        ne10*ts_src1_sorted, ne_get_rows*ne10*ts_src1_sorted, ne_get_rows*ne10*ts_src1_sorted, stream);
-    CUDA_CHECK(cudaGetLastError());
+    if (n_valid > 0) {
+        get_rows_cuda(src1->data, src1->type, ids_to_sorted, src1_sorted.ptr, type_src1_sorted,
+            ne10, nb11, nb12, nb13,
+            n_valid, 1, 1, sizeof(int32_t), ne_get_rows*sizeof(int32_t), ne_get_rows*sizeof(int32_t),
+            ne10*ts_src1_sorted, ne_get_rows*ne10*ts_src1_sorted, ne_get_rows*ne10*ts_src1_sorted, stream);
+        CUDA_CHECK(cudaGetLastError());
+    }
 
     char * src1_data_cur = (char *) src1_sorted.ptr;
     char *  dst_data_cur = (char *)  dst_sorted.ptr;
diff --git a/ggml/src/ggml-cuda/mmf.cu b/ggml/src/ggml-cuda/mmf.cu
index 040d390..f7e027c 100644
--- a/ggml/src/ggml-cuda/mmf.cu
+++ b/ggml/src/ggml-cuda/mmf.cu
@@ -132,6 +132,11 @@ void ggml_cuda_mul_mat_f(ggml_backend_cuda_context & ctx, const ggml_tensor * sr
         default:
             GGML_ABORT("unsupported type: %s", ggml_type_name(src0->type));
     }
+
+    // patch 0004: expert id -1 matches no expert above; zero its dst rows
+    if (ids) {
+        ggml_cuda_mm_ids_zero_unused(ids_d, dst_d, ne0, ids->ne[0], ids->ne[1], ids_s0, ids_s1, s1, s2, ctx.stream());
+    }
 }
 
 bool ggml_cuda_should_use_mmf(enum ggml_type type, int cc, int warp_size, const int64_t * src0_ne,
diff --git a/ggml/src/ggml-cuda/mmid.cu b/ggml/src/ggml-cuda/mmid.cu
index 6b425a3..8ffe2c1 100644
--- a/ggml/src/ggml-cuda/mmid.cu
+++ b/ggml/src/ggml-cuda/mmid.cu
@@ -159,6 +159,10 @@ static void launch_mm_ids_helper(
     const dim3 block_size(warp_size, 1, 1);
     const size_t nbytes_shared = n_tokens*sizeof(mm_ids_helper_store);
     GGML_ASSERT(nbytes_shared <= smpbo);
+    // patch 0004: ids of -1 match no expert, so fewer than n_tokens*n_expert_used columns are compacted and the
+    // seam tiles past the last column are never written. Zeroed specs are empty tiles (col_low == col_high).
+    const size_t n_tiles = (size_t(n_tokens)*n_expert_used_var + tile_width - 1)/tile_width + n_experts;
+    CUDA_CHECK(cudaMemsetAsync(tile_spec, 0, n_tiles*sizeof(ggml_cuda_mm_id_tile_spec), stream));
     mm_ids_helper<n_expert_used_template><<<num_blocks, block_size, nbytes_shared, stream>>>
         (ids, ids_src1, ids_dst, tile_spec, n_tokens, n_expert_used_var, nchannels_y, tile_width_fd, si1, sis1, write_inverse);
 }
@@ -203,3 +207,40 @@ void ggml_cuda_launch_mm_ids_helper(
             break;
     }
 }
+
+static __global__ void mm_ids_zero_unused(
+        const int32_t * __restrict__ ids, float * __restrict__ dst, const int64_t ne0, const int n_expert_used,
+        const int64_t ids_s0, const int64_t ids_s1, const int64_t dst_s1, const int64_t dst_s2) {
+    const int it  = blockIdx.x / n_expert_used;
+    const int iex = blockIdx.x % n_expert_used;
+    if (ids[iex*ids_s0 + it*ids_s1] >= 0) {
+        return;
+    }
+    float * row = dst + it*dst_s2 + iex*dst_s1;
+    for (int64_t i0 = threadIdx.x; i0 < ne0; i0 += blockDim.x) {
+        row[i0] = 0.0f;
+    }
+}
+
+void ggml_cuda_mm_ids_zero_unused(
+        const int32_t * ids, float * dst, int64_t ne0, int n_expert_used, int n_tokens,
+        int64_t ids_s0, int64_t ids_s1, int64_t dst_s1, int64_t dst_s2, cudaStream_t stream) {
+    const int64_t n_slots = (int64_t) n_tokens*n_expert_used;
+    GGML_ASSERT(n_slots < (1ll << 31));
+    mm_ids_zero_unused<<<(unsigned) n_slots, 256, 0, stream>>>(ids, dst, ne0, n_expert_used, ids_s0, ids_s1, dst_s1, dst_s2);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+static __global__ void mm_ids_fill(int32_t * __restrict__ p, const int64_t n, const int32_t v) {
+    for (int64_t i = int64_t(blockIdx.x)*blockDim.x + threadIdx.x; i < n; i += int64_t(gridDim.x)*blockDim.x) {
+        p[i] = v;
+    }
+}
+
+void ggml_cuda_mm_ids_fill(int32_t * p, int64_t n, int32_t v, cudaStream_t stream) {
+    if (n <= 0) {
+        return;
+    }
+    mm_ids_fill<<<(unsigned) ((n + 255)/256 < 1024 ? (n + 255)/256 : 1024), 256, 0, stream>>>(p, n, v);
+    CUDA_CHECK(cudaGetLastError());
+}
diff --git a/ggml/src/ggml-cuda/mmid.cuh b/ggml/src/ggml-cuda/mmid.cuh
index dc878a7..d1db96d 100644
--- a/ggml/src/ggml-cuda/mmid.cuh
+++ b/ggml/src/ggml-cuda/mmid.cuh
@@ -14,3 +14,12 @@ void ggml_cuda_launch_mm_ids_helper(
         int32_t * __restrict__ ids_src1, int32_t * __restrict__ ids_dst, ggml_cuda_mm_id_tile_spec * __restrict__ tile_spec,
         const int n_experts, const int n_tokens, const int n_expert_used, const int nchannels_y, const int tile_width,
         const int si1, const int sis1, const bool write_inverse, cudaStream_t stream);
+
+// Patch 0004: MUL_MAT_ID treats expert id -1 as no expert. The MMQ and MMF paths never match it to an expert, so they
+// leave its dst rows unwritten; this writes zeros there. dst is [ne0, n_expert_used, n_tokens] with strides in floats.
+void ggml_cuda_mm_ids_zero_unused(
+        const int32_t * ids, float * dst, int64_t ne0, int n_expert_used, int n_tokens,
+        int64_t ids_s0, int64_t ids_s1, int64_t dst_s1, int64_t dst_s2, cudaStream_t stream);
+
+// Patch 0004: p[0..n) = v. Compact-row maps are only written for matched ids; this gives the rest a safe value.
+void ggml_cuda_mm_ids_fill(int32_t * p, int64_t n, int32_t v, cudaStream_t stream);
diff --git a/ggml/src/ggml-cuda/mmq.cu b/ggml/src/ggml-cuda/mmq.cu
index 2e61997..e5fbf8e 100644
