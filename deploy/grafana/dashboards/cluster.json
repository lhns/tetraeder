{
  "uid": "tetraeder-cluster",
  "title": "Tetraeder cluster",
  "tags": [
    "tetraeder"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Links: bytes and latency per purpose",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Bytes sent per link and purpose",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, destination, tetraeder_purpose, transport) (rate(tetraeder_link_bytes_total[$__rate_interval]))",
          "legendFormat": "{{source}} to {{destination}} {{tetraeder_purpose}} ({{transport}})",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Frame round trip per purpose",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, source, destination, tetraeder_purpose) (rate(tetraeder_link_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{source}} to {{destination}} {{tetraeder_purpose}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, source, destination, tetraeder_purpose) (rate(tetraeder_link_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{source}} to {{destination}} {{tetraeder_purpose}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Refused handshakes by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(tetraeder_cluster_tls_rejected_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Nodes: up, heartbeat RTT, transitions",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Nodes up (1) or not (0)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (node) (tetraeder_cluster_node_up)",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Heartbeat round trip",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, node) (rate(tetraeder_cluster_heartbeat_rtt_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(tetraeder_cluster_heartbeat_rtt_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "C",
          "expr": "max by (node) (tetraeder_cluster_heartbeat_baseline_seconds)",
          "legendFormat": "probed {{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Node transitions by state entered",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node, to) (increase(tetraeder_cluster_node_transitions_total[$__rate_interval]))",
          "legendFormat": "{{node}} to {{to}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Pipeline: predicted and measured time per segment and hop",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Segment step time: predicted and measured",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tetraeder_segment) (tetraeder_plan_predicted_step_seconds{tetraeder_segment!=\"\"})",
          "legendFormat": "predicted segment {{tetraeder_segment}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le, tetraeder_segment) (rate(tetraeder_segment_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "measured p50 segment {{tetraeder_segment}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Hop round trip per link and purpose (hidden: hidden rows back, logits: the head's reply)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, destination, tetraeder_purpose) (rate(tetraeder_link_latency_seconds_bucket{tetraeder_purpose=~\"hidden|logits\"}[$__rate_interval])))",
          "legendFormat": "p50 to {{destination}} {{tetraeder_purpose}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, destination, tetraeder_purpose) (rate(tetraeder_link_latency_seconds_bucket{tetraeder_purpose=~\"hidden|logits\"}[$__rate_interval])))",
          "legendFormat": "p95 to {{destination}} {{tetraeder_purpose}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "Segment residual, |measured - predicted| / predicted (alert line 0.15)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, tetraeder_segment) (rate(tetraeder_plan_residual_ratio_bucket{tetraeder_segment!=\"\"}[$__rate_interval])))",
          "legendFormat": "p50 segment {{tetraeder_segment}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "vector(0.15)",
          "legendFormat": "exit-test line",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    }
  ]
}
