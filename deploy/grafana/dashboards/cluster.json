{
  "uid": "tetraeder-cluster",
  "title": "Tetraeder cluster",
  "tags": [
    "tetraeder"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Links: bytes and latency per purpose",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Bytes sent per link and purpose",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, destination, tetraeder_purpose, transport) (rate(tetraeder_link_bytes_total[$__rate_interval]))",
          "legendFormat": "{{source}} to {{destination}} {{tetraeder_purpose}} ({{transport}})",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Frame round trip per purpose",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, source, destination, tetraeder_purpose) (rate(tetraeder_link_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{source}} to {{destination}} {{tetraeder_purpose}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, source, destination, tetraeder_purpose) (rate(tetraeder_link_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{source}} to {{destination}} {{tetraeder_purpose}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Refused handshakes by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(tetraeder_cluster_tls_rejected_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    }
  ]
}
