{
  "uid": "tetraeder-overview",
  "title": "Tetraeder overview",
  "tags": [
    "tetraeder"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Time to first token",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gen_ai_server_time_to_first_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_server_time_to_first_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Time per output token",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gen_ai_server_time_per_output_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_server_time_per_output_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Tokens per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tetraeder_token_direction) (rate(tetraeder_tokens_total[$__rate_interval]))",
          "legendFormat": "{{tetraeder_token_direction}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Step duration by phase",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, tetraeder_phase) (rate(tetraeder_step_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{tetraeder_phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, tetraeder_phase) (rate(tetraeder_step_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{tetraeder_phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Device busy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tetraeder_device_busy_ratio",
          "legendFormat": "{{tetraeder_device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Memory used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tetraeder_memory_used_bytes",
          "legendFormat": "used {{tetraeder_device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "tetraeder_memory_capacity_bytes",
          "legendFormat": "capacity {{tetraeder_device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "GPU power",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tetraeder_device_power_watts",
          "legendFormat": "{{tetraeder_device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "GPU temperature",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tetraeder_device_temperature_celsius",
          "legendFormat": "{{tetraeder_device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "Request duration and errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 duration",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (error_type) (rate(gen_ai_server_request_duration_seconds_count{error_type!=\"\"}[$__rate_interval]))",
          "legendFormat": "errors/s {{error_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Model weights by tier",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tetraeder_memory_tier) (tetraeder_memory_used_bytes{tetraeder_memory_kind=\"weights\"})",
          "legendFormat": "{{tetraeder_memory_tier}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "Gateway requests by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (error_type) (rate(gen_ai_server_request_duration_seconds_count[$__rate_interval])), \"error_type\", \"ok\", \"error_type\", \"\")",
          "legendFormat": "{{error_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 13,
      "title": "Gateway admission queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(tetraeder_scheduler_queue_depth)",
          "legendFormat": "waiting",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(gen_ai_server_request_duration_seconds_count{error_type=\"overloaded\"}[$__rate_interval]))",
          "legendFormat": "rejected/s",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 14,
      "title": "Request cost by caller",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tetraeder_caller) (rate(tetraeder_request_cost_sum{tetraeder_cost_resource=\"gpu_seconds\"}[$__rate_interval]))",
          "legendFormat": "{{tetraeder_caller}} GPU-s/s",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (tetraeder_caller) (rate(tetraeder_request_cost_sum{tetraeder_cost_resource=\"bytes_streamed\"}[$__rate_interval]))",
          "legendFormat": "{{tetraeder_caller}} bytes/s",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 15,
      "title": "Experts and cache",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "title": "Expert cache hit rate",
      "description": "Slot lookups that found the expert resident, by tier; the second series is the share of experts computed on the CPU instead (ADR 0035).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tetraeder_memory_tier) (rate(tetraeder_expert_cache_requests_total{tetraeder_result=\"hit\"}[$__rate_interval])) / sum by (tetraeder_memory_tier) (rate(tetraeder_expert_cache_requests_total[$__rate_interval]))",
          "legendFormat": "{{tetraeder_memory_tier}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (tetraeder_memory_tier) (rate(tetraeder_expert_cache_requests_total{tetraeder_result=\"cpu\"}[$__rate_interval])) / sum by (tetraeder_memory_tier) (rate(tetraeder_expert_cache_requests_total[$__rate_interval]))",
          "legendFormat": "{{tetraeder_memory_tier}} computed on CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 17,
      "title": "Layers fully resident",
      "description": "MoE layer steps with every top-k expert resident; decides whether whole-step graphs pay (ADR 0030).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 6,
        "y": 41,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tetraeder_expert_layer_hit_total{tetraeder_result=\"full\"}[$__rate_interval])) / sum(rate(tetraeder_expert_layer_hit_total[$__rate_interval]))",
          "legendFormat": "full",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 18,
      "title": "Expert load duration",
      "description": "Time to bring one expert into a slot, by destination tier and source.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, tetraeder_memory_tier, tetraeder_source) (rate(tetraeder_expert_load_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{tetraeder_memory_tier}} from {{tetraeder_source}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, tetraeder_memory_tier, tetraeder_source) (rate(tetraeder_expert_load_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{tetraeder_memory_tier}} from {{tetraeder_source}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 19,
      "title": "Tier read bandwidth",
      "description": "Bytes per second read from each memory tier.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 41,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tetraeder_device, tetraeder_memory_tier) (rate(tetraeder_tier_read_bytes_total[$__rate_interval]))",
          "legendFormat": "{{tetraeder_device}} {{tetraeder_memory_tier}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 20,
      "title": "Segments per step",
      "description": "Mean graph segments per engine step; n_layer + 1 for the own builder (ADR 0030), 1 for libllama.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tetraeder_phase) (rate(tetraeder_step_segments_sum[$__rate_interval])) / sum by (tetraeder_phase) (rate(tetraeder_step_segments_count[$__rate_interval]))",
          "legendFormat": "{{tetraeder_phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 21,
      "title": "Prefetch accuracy",
      "description": "Share of the experts predicted one layer ahead (depth 1) or two (depth 2) that the router then chose, mean over layers (ADR 0038). Below about 0.4 the prefetch mostly wastes disk bandwidth.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 6,
        "y": 49,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tetraeder_prefetch_depth) (rate(tetraeder_expert_prefetch_accuracy_ratio_sum[$__rate_interval])) / sum by (tetraeder_prefetch_depth) (rate(tetraeder_expert_prefetch_accuracy_ratio_count[$__rate_interval]))",
          "legendFormat": "depth {{tetraeder_prefetch_depth}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 22,
      "title": "Prefetched experts",
      "description": "Experts read ahead into the RAM tier per second, by result: issued, used (routed while resident) and wasted (evicted before they were routed). Wasted bytes per second on the second series.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tetraeder_result) (rate(tetraeder_expert_prefetch_total[$__rate_interval]))",
          "legendFormat": "{{tetraeder_result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(tetraeder_expert_prefetch_wasted_bytes_total[$__rate_interval]))",
          "legendFormat": "wasted bytes/s",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 23,
      "title": "Speculation acceptance",
      "description": "Share of drafted tokens the target accepted, per drafting method (ADR 0043). Below about 0.3 speculation likely costs more than it saves.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 49,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tetraeder_spec_method) (rate(tetraeder_spec_accepted_total[$__rate_interval])) / sum by (tetraeder_spec_method) (rate(tetraeder_spec_drafted_total[$__rate_interval]))",
          "legendFormat": "{{tetraeder_spec_method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 24,
      "title": "Drafted and accepted tokens",
      "description": "Tokens drafted for verification and accepted by the target per second, per drafting method (ADR 0043).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tetraeder_spec_method) (rate(tetraeder_spec_drafted_total[$__rate_interval]))",
          "legendFormat": "drafted {{tetraeder_spec_method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (tetraeder_spec_method) (rate(tetraeder_spec_accepted_total[$__rate_interval]))",
          "legendFormat": "accepted {{tetraeder_spec_method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 25,
      "title": "Planner and detector",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 26,
      "title": "Predicted vs measured step time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
